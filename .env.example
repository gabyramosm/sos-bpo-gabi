# ─────────────────────────────────────────────────────────────
# Variables de entorno para SOS BPO · Gabi
# Copiar este archivo como .env.local para desarrollo local
# En Vercel: configurar en Dashboard → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# IBM Cloud IAM API Key
# Obtener en: https://cloud.ibm.com/iam/apikeys → "Create an IBM Cloud API key"
WATSONX_API_KEY=tu_api_key_aqui

# IBM watsonx.ai Project ID
# Obtener en: https://dataplatform.cloud.ibm.com → tu proyecto → Manage → General → Project ID
WATSONX_PROJECT_ID=tu_project_id_aqui
